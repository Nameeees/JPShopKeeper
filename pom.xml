<?xml version="1.0" encoding="UTF-8"?>
<!--
  JPShopKeeper
  ================================================================
  Compilado contra Spigot 1.8.8 con bytecode Java 8 a proposito:
  un unico JAR funciona desde la 1.8 hasta la ultima version.
  NO usar constantes de Material/Sound/EntityType del enum en codigo:
  se resuelven por nombre en tiempo de ejecucion (ver paquete util).
  ================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jp</groupId>
    <artifactId>JPShopKeeper</artifactId>
    <version>1.1.0</version>
    <packaging>jar</packaging>

    <name>JPShopKeeper</name>
    <description>NPCs comerciantes con tradeos y paginas configurables por menu. Compatible 1.8 - ultima version.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Bytecode Java 8: obligatorio para poder cargar en servidores 1.8 -->
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <repositories>
        <!-- Spigot API 1.8.8 (servidor legado mas bajo soportado) -->
        <repository>
            <id>spigot-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
        <!-- Vault API (soft-dependency de economia) -->
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
        <!-- PlaceholderAPI (soft-dependency): placeholders %jpsk_...% -->
        <repository>
            <id>placeholderapi</id>
            <url>https://repo.extendedclip.com/content/repositories/placeholderapi/</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- API del servidor: compilamos contra la mas antigua soportada -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.8.8-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- Vault: solo compilacion. Si el servidor no lo tiene, la economia se desactiva sola -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>org.bukkit</groupId>
                    <artifactId>bukkit</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- PlaceholderAPI: solo compilacion; sin el plugin no se registra nada -->
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.11.6</version>
            <scope>provided</scope>
        </dependency>

        <!-- Pruebas de la logica pura (no necesitan un servidor) -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- plugin.yml con version del proyecto inyectada -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>plugin.yml</include>
                </includes>
            </resource>
            <!-- el resto de recursos, tal cual (sin tocar colores ni simbolos) -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
        </plugins>
    </build>

</project>
